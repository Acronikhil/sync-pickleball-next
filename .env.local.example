# Copy to .env.local (git-ignored) to sign in to /admin while running `npm run dev`.
# Use the same values as the GitHub repository variables the deploy workflow
# reads (Settings → Secrets and variables → Actions → Variables).
#
# Also add http://localhost:3000 to the Google OAuth client's
# "Authorised JavaScript origins", or Google will refuse the sign-in.
#
# Careful: Publish from a local admin commits to the real `main` branch.

NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_PUBLISH_URL=
NEXT_PUBLIC_ADMIN_EMAILS=
